{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Harness Designer",
  "version": "0.1.7",
  "identifier": "com.martinbinaghi.arneses",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Harness Designer",
        "width": 1180,
        "height": 760,
        "decorations": false,
        "zoomHotkeysEnabled": true,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/default-library.db": "resources/default-library.db",
      "resources/sample-project.db": "resources/sample-project.db"
    },
    "shortDescription": "Wiring harness design for race cars",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFCMzlFQkZERjEyNjJFNDMKUldSRExpYngvZXM1cXpwTVhqRlBmUUtGeTQzR3JSYkJIU25taWE1STVPbEV4YWpTUHFST0RGQVQK",
      "endpoints": [
        "https://github.com/MartinBinaghi/harness-designer/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
